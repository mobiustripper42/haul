# Postgres connection string. Required in production; development falls back to the local docker database.
DATABASE_URL=
# Signs session cookies. At least 32 characters; required in production. Rotating it signs everyone out.
SESSION_SECRET=
# Resend API key. With EMAIL_FROM set, sign-in codes are emailed; without both, development prints them to the server console.
RESEND_API_KEY=
# The From address Resend sends as, e.g. Ohio City Farm <members@example.com>. Required in production.
EMAIL_FROM=
# The site's public address, no trailing slash needed, e.g. https://members.ohiocityfarm.com. Sign-in links in emails point here. Required in production, and must start with https://; development falls back to http://localhost:4000.
SITE_URL=
# Square environment, sandbox or production. Required whenever SQUARE_ACCESS_TOKEN and SQUARE_LOCATION_ID are set; anything else, or unset, fails.
SQUARE_ENVIRONMENT=
# Square access token for that environment. With SQUARE_LOCATION_ID set, signup charges through Square; without both, development and test use a fake and production refuses to start a payment.
SQUARE_ACCESS_TOKEN=
# Square location id the charges are made at, and the payment lookup searches.
SQUARE_LOCATION_ID=
# Square application id, from the developer dashboard. Sent to the browser for Square's card form; a sandbox id starts with sandbox-.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# The same location id, for Square's card form in the browser.
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Square sandbox access token. Read by npm run test:square only, never read by the app; the suite fails without it.
SQUARE_SANDBOX_ACCESS_TOKEN=
# Square sandbox location id. Read by npm run test:square only, never read by the app; the suite fails without it.
SQUARE_SANDBOX_LOCATION_ID=
# The farm's email address, shown on the sold-out card as "Questions? Email the farm at ...". Optional; the line is left out when unset.
FARM_CONTACT_EMAIL=
# The bearer secret the scheduler sends to GET /api/charge-run, which fires the charge run: Authorization: Bearer <this>. Anything else gets a 404; unset or empty, the route answers 404 to everyone. Required in production for the run to fire.
CRON_SECRET=
