# Postgres connection string. Required in production; development falls back to the local docker database.
DATABASE_URL=
# Signs session cookies. At least 32 characters; required in production. Rotating it signs everyone out.
SESSION_SECRET=
# Resend API key. With EMAIL_FROM set, sign-in codes are emailed; without both, development prints them to the server console.
RESEND_API_KEY=
# The From address Resend sends as, e.g. Ohio City Farm <members@example.com>. Required in production.
EMAIL_FROM=
